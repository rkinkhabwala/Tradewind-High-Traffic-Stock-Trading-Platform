# Copy to .env and adjust. Never commit .env.

# Postgres (single instance, one logical database per service)
POSTGRES_USER=tradewind
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Kafka (KRaft, single node for local dev)
KAFKA_PORT=9092

# Redis
REDIS_PORT=6379

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Service ports
GATEWAY_PORT=8080
ACCOUNT_SERVICE_PORT=8081
MARKETDATA_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
EXECUTION_SERVICE_PORT=8084
PORTFOLIO_SERVICE_PORT=8085
