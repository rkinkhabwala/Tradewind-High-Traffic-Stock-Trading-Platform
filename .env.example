# Copy to .env and adjust. Never commit .env.

# Postgres (single instance, one logical database per service)
POSTGRES_USER=tradewind
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Kafka (KRaft, single node for local dev)
KAFKA_PORT=9092

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Service ports
GATEWAY_PORT=8080
ACCOUNT_SERVICE_PORT=8081
MARKETDATA_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
EXECUTION_SERVICE_PORT=8084
PORTFOLIO_SERVICE_PORT=8085
STREAM_SERVICE_PORT=8086
# Web app (nginx): http://localhost:3001
WEB_PORT=3001

# Where the gateway routes to (defaults are localhost; compose overrides with service names)
ACCOUNT_SERVICE_URL=http://localhost:8081
MARKETDATA_SERVICE_URL=http://localhost:8082
ORDER_SERVICE_URL=http://localhost:8083
PORTFOLIO_SERVICE_URL=http://localhost:8085

# Seed users demo1@tradewind.test and demo2@tradewind.test ($100,000 each) log in with this password
DEMO_USER_PASSWORD=change-me-demo

# Auth (account-service signs, gateway verifies via account-service's JWKS)
JWT_ISSUER=tradewind-account
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
# PKCS#8 PEM RSA private key. Leave empty in local dev to use an ephemeral key:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
JWT_PRIVATE_KEY=

# Kafka bootstrap for services running on the host
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Simulated market clock (shared by all services).
#   FAST: market time = MARKET_CLOCK_SIM_START + (now - anchor) x MARKET_CLOCK_SPEED.
#   The anchor is stored in Redis (market:clock-anchor) by the first service to start; delete it to reset.
#   Set MARKET_CLOCK_REAL_EPOCH (ISO-8601) to pin the anchor instead. WALL: real New York time.
MARKET_CLOCK_MODE=FAST
MARKET_CLOCK_SPEED=1
MARKET_CLOCK_SIM_START=2026-01-05T09:29:00-05:00
MARKET_CLOCK_REAL_EPOCH=

# Price simulator (spec 6.1)
SIMULATOR_ENABLED=true
SIMULATOR_TICK_RATE_MIN=1
SIMULATOR_TICK_RATE_MAX=10
# Meme-stock mode: e.g. GME ticks 100x/s with 5x volatility. Empty = off.
SIMULATOR_HOT_SYMBOL=
SIMULATOR_HOT_TICK_RATE=100
SIMULATOR_HOT_VOLATILITY_MULTIPLIER=5
SIMULATOR_SEED=0

# Funding: largest single simulated deposit/withdrawal ($1,000,000)
FUNDING_MAX_AMOUNT_CENTS=100000000

# Orders: concurrent reservation calls to portfolio-service (bulkhead), and how long a PENDING order may
# wait before the sweeper rejects it and releases its reservation
PORTFOLIO_MAX_CONCURRENT_CALLS=64
ORDER_PENDING_TIMEOUT=30s

# Ledger: optimistic-lock retries before answering 503
LEDGER_MAX_ATTEMPTS=20

# Refresh-token cookie Secure flag (browsers accept Secure cookies on http://localhost; set false only for
# plain-http access from another host)
AUTH_COOKIE_SECURE=true

# One-time WebSocket ticket lifetime (POST /api/ws/ticket, then /ws?ticket=...)
WS_TICKET_TTL=30s

# Portfolio history: how often to check for a new 5-simulated-minute snapshot bucket
SNAPSHOT_CHECK_INTERVAL=2s

# stream-service WebSocket fan-out (spec 6.2). Not published on the host; reached through the gateway's /ws.
# The gateway resolves STREAM_SERVICE_HOST to every instance (Docker DNS with --scale), health-checks each every
# STREAM_DISCOVERY_INTERVAL and spreads connections round-robin.
STREAM_SERVICE_HOST=localhost
STREAM_DISCOVERY_INTERVAL=2s
STREAM_CONFLATION_INTERVAL=250ms
STREAM_MAX_SUBSCRIPTIONS=100
STREAM_SLOW_CLIENT_TIMEOUT=10s
STREAM_HEARTBEAT_INTERVAL=15s
STREAM_IDLE_TIMEOUT=45s

# Gateway per-user order rate limit (spec 6.3)
ORDER_RATE_LIMIT_PER_SECOND=10
ORDER_RATE_LIMIT_BURST=20
